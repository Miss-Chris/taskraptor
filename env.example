# TaskRaptor self-host environment
# Copy this file to env.txt and fill in the required values.

# =============================================================================
# REQUIRED
# =============================================================================

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Generate with the same command. Required by docker-compose Redis auth.
REDIS_PASSWORD=

# External PostgreSQL connection.
# Use PGSSLMODE=require for RDS or managed Postgres.
# Use PGSSLMODE=disable for a local Postgres server on the same EC2 host.
PGHOST=
PGPORT=5432
PGDATABASE=taskraptor
PGUSER=taskraptor
PGPASSWORD=
PGSSLMODE=require

# =============================================================================
# APPLICATION
# =============================================================================

# Comma-separated hostnames that may serve this app.
# Examples:
# ALLOWED_HOSTS=taskraptor.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Only needed if you serve Django forms or admin over HTTPS from a domain.
# Example:
# CSRF_TRUSTED_ORIGINS=https://taskraptor.example.com
CSRF_TRUSTED_ORIGINS=

# Enable these when serving through HTTPS.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Session token lifetime for browser/API logins.
USER_SESSION_TTL_DAYS=30

# Disable public signups for private/self-hosted instances.
ALLOW_PUBLIC_REGISTRATION=true

# =============================================================================
# LLM AND CHANNEL INTEGRATIONS
# =============================================================================

# Required for the built-in system_free LLM config.
DEEPSEEK_API_KEY=

# Request quota assigned to newly created system_free user models.
# Set to 0 to create accounts with no free system-model requests.
SYSTEM_FREE_MONTHLY_REQUEST_QUOTA=50

# Optional Telegram bot integration.
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# INTERNAL SERVICES
# =============================================================================

# Defaults are derived from REDIS_PASSWORD:
# redis://:<REDIS_PASSWORD>@redis:6379/0
# Override only when using an external broker/result backend.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
