# TaskRaptor self-host environment
# Copy this file to env.txt and fill in the required values.

# =============================================================================
# REQUIRED
# =============================================================================

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# External PostgreSQL connection.
# Use PGSSLMODE=require for RDS or managed Postgres.
# Use PGSSLMODE=disable for a local Postgres server on the same EC2 host.
PGHOST=
PGPORT=5432
PGDATABASE=taskraptor
PGUSER=taskraptor
PGPASSWORD=
PGSSLMODE=require

# =============================================================================
# APPLICATION
# =============================================================================

# Comma-separated hostnames that may serve this app.
# Examples:
# ALLOWED_HOSTS=taskraptor.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Only needed if you serve Django forms or admin over HTTPS from a domain.
# Example:
# CSRF_TRUSTED_ORIGINS=https://taskraptor.example.com
CSRF_TRUSTED_ORIGINS=

# Session token lifetime for browser/API logins.
USER_SESSION_TTL_DAYS=30

# =============================================================================
# LLM AND CHANNEL INTEGRATIONS
# =============================================================================

# Required for the built-in system_free LLM config.
DEEPSEEK_API_KEY=

# Optional Telegram bot integration.
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=

# =============================================================================
# INTERNAL SERVICES
# =============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
